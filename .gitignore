# Reversa
.reversa/config.user.toml

# Framework vendorizado — reinstalável com `npx reversa install`
# (com `/*` para permitir a exceção abaixo; o diretório inteiro ignorado não deixa reincluir nada)
.claude/skills/*
.agents/skills/*
# Skill do projeto, versionada (feature 006)
!.claude/skills/analisar-lotes/
!.agents/skills/analisar-lotes/

# Skills e loops pessoais do Rafael, fora do projeto
.claude/multiagents-debate-loop/
loops/

# Segredos — credenciais dos leiloeiros e token do bot
.env
*.env

# Bancos locais — motor-filtros e agendador-observabilidade
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.pyc
.venv/
venv/

# Dados locais do bot — banco, trava e logs
dados/

# Relatórios por varredura (emenda E001) — histórico de interesse de compra, fora do git
1OUTPUT/

# Artefatos de empacotamento
build/
